{
    "rules": {
        "events": {
            "$eventId": {
                "metadata": {
                    ".read": true,
                    ".write": true,
                    ".validate": "newData.hasChildren(['name', 'creator', 'createdAt', 'lastActive'])"
                },
                "adminToken": {
                    ".read": false,
                    ".write": "!data.exists()"
                },
                "data": {
                    ".read": true,
                    ".write": true
                },
                "presence": {
                    ".read": true,
                    ".write": true
                }
            }
        }
    }
}