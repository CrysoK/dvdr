{
    "rules": {
        "events": {
            ".indexOn": ["metadata/lastActive"],
            "$eventId": {
                "metadata": {
                    ".read": "auth != null",
                    ".write": "auth != null && (!data.exists() || newData.exists() || data.child('creator_uid').val() === auth.uid)",
                    ".validate": "newData.hasChildren(['name', 'creator', 'createdAt', 'lastActive'])",
                    "creator_uid": {
                        ".validate": "!data.exists() || data.val() === newData.val()"
                    }
                },
                "adminToken": {
                    ".read": false,
                    ".write": "auth != null && (!data.exists() || (newData.val() === null && root.child('events/'+$eventId+'/metadata/creator_uid').val() === auth.uid))"
                },
                "data": {
                    ".read": "auth != null",
                    ".write": "auth != null && (!data.exists() || newData.exists() || root.child('events/'+$eventId+'/metadata/creator_uid').val() === auth.uid)"
                },
                "presence": {
                    ".read": "auth != null",
                    ".write": "auth != null"
                }
            }
        }
    }
}